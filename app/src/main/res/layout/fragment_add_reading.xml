<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Toolbar -->
        <com.google.android.material.appbar.MaterialToolbar
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:title="Добавить показания"
            app:titleTextColor="@color/colorTextPrimary" />

        <!-- ═══════════════════════════════════════════════════════════
             БЛОК 1: Номер счётчика — сканирование QR/штрихкода
             ═══════════════════════════════════════════════════════════ -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="4dp"
            android:text="Шаг 1 — Номер счётчика"
            android:textSize="13sp"
            android:textColor="@color/colorTextSecondary"
            android:textAllCaps="true"
            android:letterSpacing="0.06" />

        <!-- Поле номера счётчика с иконкой-кнопкой QR слева -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilSerialNumber"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Нажмите значок для сканирования"
            app:startIconDrawable="@drawable/ic_qr_scan"
            app:startIconTint="@color/colorPrimary"
            app:endIconMode="clear_text"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etSerialNumber"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text"
                android:imeOptions="actionNext"
                android:hint="Номер счётчика (QR / штрихкод)" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- Статус сканирования QR -->
        <TextView
            android:id="@+id/tvScanStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textSize="12sp"
            android:textColor="@color/colorTextSecondary"
            android:visibility="gone" />

        <!-- ═══════════════════════════════════════════════════════════
             БЛОК 2: Показания — фото + OCR
             ═══════════════════════════════════════════════════════════ -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="4dp"
            android:text="Шаг 2 — Показания счётчика"
            android:textSize="13sp"
            android:textColor="@color/colorTextSecondary"
            android:textAllCaps="true"
            android:letterSpacing="0.06" />

        <!-- Поле показаний с иконкой-кнопкой камеры слева -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilReading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Нажмите значок для съёмки"
            app:startIconDrawable="@drawable/ic_camera"
            app:startIconTint="@color/colorPrimary"
            app:suffixText="м³"
            app:endIconMode="clear_text"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etReading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number"
                android:imeOptions="actionDone"
                android:hint="Показания (целые м³)" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- OCR progress -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="6dp">

            <ProgressBar
                android:id="@+id/progressOcr"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvOcrStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:textSize="12sp"
                android:textColor="@color/colorTextSecondary"
                android:visibility="gone" />

        </LinearLayout>

        <!-- Превью фото со счётчиком + круглая рамка -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardPreview"
            android:layout_width="match_parent"
            android:layout_height="260dp"
            android:layout_marginTop="12dp"
            android:visibility="gone"
            app:cardCornerRadius="12dp">

            <ImageView
                android:id="@+id/imgPreview"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:contentDescription="Превью счётчика" />

            <com.watermeter.ui.add.MeterFrameOverlay
                android:id="@+id/meterFrameOverlay"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

        </com.google.android.material.card.MaterialCardView>

        <!-- Подсказка под превью -->
        <TextView
            android:id="@+id/tvHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Циферблат в круге — для лучшего распознавания"
            android:textAlignment="center"
            android:textSize="12sp"
            android:textColor="@color/colorTextSecondary"
            android:visibility="gone" />

        <!-- Необязательное название счётчика -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="4dp"
            android:text="Дополнительно"
            android:textSize="13sp"
            android:textColor="@color/colorTextSecondary"
            android:textAllCaps="true"
            android:letterSpacing="0.06" />

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Название счётчика (необязательно)"
            app:startIconDrawable="@drawable/ic_label"
            app:endIconMode="clear_text"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etMeterName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text"
                android:imeOptions="actionDone" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- Кнопки одинакового размера -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="16dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnReset"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:text="Очистить"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSave"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:text="Сохранить"
                android:backgroundTint="@color/colorPrimary" />

        </LinearLayout>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
